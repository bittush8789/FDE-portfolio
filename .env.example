# -----------------------------------------------------------------------------
# Portfolio Environment Variables
# -----------------------------------------------------------------------------
# Copy this file to .env.local and populate the keys:
# cp .env.example .env.local
# -----------------------------------------------------------------------------

# Apify API Token (Optional)
# Powers live on-demand job scraping in the "/jobs" dashboard (LinkedIn, Indeed, Naukri).
# If omitted, the dashboard displays the curated/cached job database.
# Get token at: https://console.apify.com/account/integrations
APIFY_TOKEN=

# Tavily API Key (Optional)
# Powers the real-time "AI Pulse" tech/AI news feed on the homepage.
# If omitted, the section gracefully displays a "not configured" notice.
# Get free key at: https://tavily.com
TAVILY_API_KEY=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

